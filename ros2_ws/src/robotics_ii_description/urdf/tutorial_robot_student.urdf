<?xml version="1.0"?>
<robot name="robotics_ii_student_robot">
  <material name="student_blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>

  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="student_blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.008" ixy="0" ixz="0"
               iyy="0.008" iyz="0" izz="0.014"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.40"/></geometry>
      <material name="student_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.40"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0139" ixy="0" ixz="0"
               iyy="0.0139" iyz="0" izz="0.0011"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="20" velocity="1.5"/>
  </joint>

  <!-- TODO: add link_2, revolute joint_2 and a fixed tool0 frame.
       Every moving link must include visual, collision and inertial elements.
       Keep the file valid after each small edit. -->
</robot>

