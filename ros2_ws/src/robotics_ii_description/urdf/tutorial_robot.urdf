<?xml version="1.0"?>
<robot name="robotics_ii_tutorial_robot">

  <material name="vub_blue">
    <color rgba="0.05 0.25 0.70 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.35 0.05 1.0"/>
  </material>

  <!-- KDL expects a massless root; the inertial base is its child. -->
  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.008" ixy="0.0" ixz="0.0"
               iyy="0.008" iyz="0.0" izz="0.014"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.40"/></geometry>
      <material name="vub_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.40"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0139" ixy="0.0" ixz="0.0"
               iyy="0.0139" iyz="0.0" izz="0.0011"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="20.0" velocity="1.5"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry><box size="0.36 0.065 0.065"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <geometry><box size="0.36 0.065 0.065"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.18 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0"
               iyy="0.0067" iyz="0.0" izz="0.0067"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.5"/>
  </joint>

  <link name="tool0">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="light_grey"/>
    </visual>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="link_2"/>
    <child link="tool0"/>
    <origin xyz="0.36 0 0" rpy="0 0 0"/>
  </joint>
</robot>
