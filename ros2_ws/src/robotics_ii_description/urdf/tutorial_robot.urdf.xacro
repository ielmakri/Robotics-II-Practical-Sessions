<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotics_ii_xacro_robot">
  <xacro:property name="base_radius" value="0.12"/>
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="upper_arm_length" value="0.40"/>
  <xacro:property name="upper_arm_width" value="0.08"/>
  <xacro:property name="upper_arm_mass" value="1.0"/>
  <xacro:property name="link_length" value="0.36"/>
  <xacro:property name="forearm_width" value="0.065"/>
  <xacro:property name="forearm_mass" value="0.60"/>

  <material name="course_blue"><color rgba="0.05 0.25 0.70 1"/></material>
  <material name="course_orange"><color rgba="0.95 0.35 0.05 1"/></material>
  <material name="course_grey"><color rgba="0.75 0.75 0.75 1"/></material>

  <xacro:macro name="box_link_x" params="name length width mass material">
    <link name="${name}">
      <visual>
        <origin xyz="${length / 2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${length} ${width} ${width}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="${length / 2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${length} ${width} ${width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${length / 2} 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (width * width + width * width) / 12}"
          ixy="0" ixz="0"
          iyy="${mass * (length * length + width * width) / 12}"
          iyz="0"
          izz="${mass * (length * length + width * width) / 12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="box_link_z" params="name length width mass material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <geometry><box size="${width} ${width} ${length}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <geometry><box size="${width} ${width} ${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (width * width + length * length) / 12}"
          ixy="0" ixz="0"
          iyy="${mass * (width * width + length * length) / 12}"
          iyz="0"
          izz="${mass * (width * width + width * width) / 12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <material name="course_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.008" ixy="0.0" ixz="0.0"
               iyy="0.008" iyz="0.0" izz="0.014"/>
    </inertial>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
  </joint>

  <xacro:box_link_z name="link_1"
                    length="${upper_arm_length}"
                    width="${upper_arm_width}"
                    mass="${upper_arm_mass}"
                    material="course_blue"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 ${base_height / 2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" effort="20.0" velocity="1.5"/>
  </joint>

  <xacro:box_link_x name="link_2"
                    length="${link_length}"
                    width="${forearm_width}"
                    mass="${forearm_mass}"
                    material="course_orange"/>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${upper_arm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.5"/>
  </joint>

  <link name="tool0">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="course_grey"/>
    </visual>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="link_2"/>
    <child link="tool0"/>
    <origin xyz="${link_length} 0 0" rpy="0 0 0"/>
  </joint>
</robot>
