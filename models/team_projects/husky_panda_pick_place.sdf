<?xml version="1.0"?>
<sdf xmlns:drake="http://drake.mit.edu" version="1.7">
  <world name="session3_mobile_manipulator_pick_place">
    <include>
      <uri>package://robotics_ii_models/objects_scenes/floor.sdf</uri>
      <name>ground_floor</name>
    </include>

    <!-- Keep the robot assembly in one nested SDF model. The fixed joint
         carries the Panda with the free-moving Husky base. -->
    <model name="mobile_manipulator">
      <pose>-0.85 -0.55 0.13228 0 0 0</pose>
      <include>
        <uri>package://robotics_ii_models/descriptions/robots/mobile/clearpath_husky/urdf/husky.urdf</uri>
        <name>husky_runner</name>
      </include>
      <include>
        <uri>package://robotics_ii_models/descriptions/robots/arms/panda_fer/urdf/panda_fer_hand.urdf</uri>
        <name>panda_inspector</name>
        <!-- The include pose is relative to the plate link; place panda_link0
             at the plate's upper face, 6.35 mm above that link's origin. -->
        <pose relative_to="husky_runner::top_plate_link">0 0 0.00635 0 0 0</pose>
      </include>
      <joint name="panda_mount_joint" type="fixed">
        <parent>husky_runner::top_plate_link</parent>
        <child>panda_inspector::panda_link0</child>
        <pose relative_to="husky_runner::top_plate_link">0 0 0.00635 0 0 0</pose>
      </joint>
    </model>

    <!-- 73 cm high workbench: the OBJ provides the tabletop, four box legs
         reach the floor, and box proxies keep contact calculations simple. -->
    <model name="replenishment_workbench">
      <static>true</static>
      <pose>0 -0.55 0.70 0 0 0</pose>
      <link name="workbench">
        <visual name="mesh_visual">
          <geometry>
            <mesh>
              <uri>package://robotics_ii_models/team_projects/assets/workbench.obj</uri>
              <!-- Dimensions are baked into the OBJ; keep Drake mesh scale uniform. -->
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material><diffuse>0.42 0.47 0.53 1</diffuse></material>
        </visual>
        <collision name="tabletop_collision">
          <geometry><box><size>0.60 0.55 0.06</size></box></geometry>
        </collision>

        <visual name="front_left_leg_visual">
          <pose>-0.25 -0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><diffuse>0.30 0.34 0.40 1</diffuse></material>
        </visual>
        <collision name="front_left_leg_collision">
          <pose>-0.25 -0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="front_right_leg_visual">
          <pose>-0.25 0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><diffuse>0.30 0.34 0.40 1</diffuse></material>
        </visual>
        <collision name="front_right_leg_collision">
          <pose>-0.25 0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="rear_left_leg_visual">
          <pose>0.25 -0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><diffuse>0.30 0.34 0.40 1</diffuse></material>
        </visual>
        <collision name="rear_left_leg_collision">
          <pose>0.25 -0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="rear_right_leg_visual">
          <pose>0.25 0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><diffuse>0.30 0.34 0.40 1</diffuse></material>
        </visual>
        <collision name="rear_right_leg_collision">
          <pose>0.25 0.225 -0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Open-top 15 x 6.5 x 7.5 cm parts tote. Its narrow sides fit inside
         the Panda's 70 mm starting finger gap. -->
    <model name="supply_bin">
      <pose>-0.20 -0.55 0.7675 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>1.23125e-4</ixx><iyy>3.515625e-4</iyy><izz>3.340625e-4</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="bottom_visual">
          <pose>0 0 -0.0345 0 0 0</pose>
          <geometry><box><size>0.15 0.065 0.006</size></box></geometry>
          <material><diffuse>0.08 0.34 0.47 1</diffuse></material>
        </visual>
        <collision name="bottom_collision">
          <pose>0 0 -0.0345 0 0 0</pose>
          <geometry><box><size>0.15 0.065 0.006</size></box></geometry>
          <drake:proximity_properties>
            <drake:mu_dynamic>1.0</drake:mu_dynamic>
            <drake:mu_static>1.2</drake:mu_static>
          </drake:proximity_properties>
        </collision>

        <visual name="left_long_wall_visual">
          <pose>0 0.0295 0 0 0 0</pose>
          <geometry><box><size>0.15 0.006 0.075</size></box></geometry>
          <material><diffuse>0.12 0.55 0.72 1</diffuse></material>
        </visual>
        <collision name="left_long_wall_collision">
          <pose>0 0.0295 0 0 0 0</pose>
          <geometry><box><size>0.15 0.006 0.075</size></box></geometry>
          <drake:proximity_properties>
            <drake:mu_dynamic>1.0</drake:mu_dynamic>
            <drake:mu_static>1.2</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="right_long_wall_visual">
          <pose>0 -0.0295 0 0 0 0</pose>
          <geometry><box><size>0.15 0.006 0.075</size></box></geometry>
          <material><diffuse>0.12 0.55 0.72 1</diffuse></material>
        </visual>
        <collision name="right_long_wall_collision">
          <pose>0 -0.0295 0 0 0 0</pose>
          <geometry><box><size>0.15 0.006 0.075</size></box></geometry>
          <drake:proximity_properties>
            <drake:mu_dynamic>1.0</drake:mu_dynamic>
            <drake:mu_static>1.2</drake:mu_static>
          </drake:proximity_properties>
        </collision>

        <visual name="front_short_wall_visual">
          <pose>0.072 0 0 0 0 0</pose>
          <geometry><box><size>0.006 0.059 0.075</size></box></geometry>
          <material><diffuse>0.12 0.55 0.72 1</diffuse></material>
        </visual>
        <collision name="front_short_wall_collision">
          <pose>0.072 0 0 0 0 0</pose>
          <geometry><box><size>0.006 0.059 0.075</size></box></geometry>
          <drake:proximity_properties>
            <drake:mu_dynamic>1.0</drake:mu_dynamic>
            <drake:mu_static>1.2</drake:mu_static>
          </drake:proximity_properties>
        </collision>
        <visual name="rear_short_wall_visual">
          <pose>-0.072 0 0 0 0 0</pose>
          <geometry><box><size>0.006 0.059 0.075</size></box></geometry>
          <material><diffuse>0.12 0.55 0.72 1</diffuse></material>
        </visual>
        <collision name="rear_short_wall_collision">
          <pose>-0.072 0 0 0 0 0</pose>
          <geometry><box><size>0.006 0.059 0.075</size></box></geometry>
          <drake:proximity_properties>
            <drake:mu_dynamic>1.0</drake:mu_dynamic>
            <drake:mu_static>1.2</drake:mu_static>
          </drake:proximity_properties>
        </collision>
      </link>
    </model>

    <model name="delivery_zone">
      <static>true</static>
      <pose>-1.25 -0.55 0.006 0 0 0</pose>
      <link name="marker">
        <visual name="visual">
          <geometry><box><size>0.45 0.55 0.01</size></box></geometry>
          <material><diffuse>0.1 0.7 0.35 0.45</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
